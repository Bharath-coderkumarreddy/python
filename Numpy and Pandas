# Numpy Array Operations:
# 1. Create a 1D NumPy Array:
import numpy as np
temperatures_w1 = np.array([22.5, 25.3, 20.8, 23.4, 26.1, 24.8, 21.9])
print(temperatures_w1)

# 2. Inspection and Properties:
print(temperatures_w1.shape)
print(temperatures_w1.dtype)
print(temperatures_w1.size)

# 3. Array Operations:
f = []
for i in temperatures_w1:
    Fahrenheit = (i * 9/5) + 32
    f.append(Fahrenheit)
print(f)

print(np.max(f))
print(np.min(f))
print(np.mean(f))

# 4. Array Slicing and Indexing:
print(temperatures_w1[:3])
print(temperatures_w1[-2:])
print(temperatures_w1[2:5])

# 5. Create a 2D Array:

temperatures = np.array([[22.5, 25.3, 20.8, 23.4, 26.1, 24.8, 21.9],[19.2, 22.5, 21.3, 24.0, 23.5, 22.8, 20.1]])
print(temperatures.shape)
print(temperatures.dtype)
print(temperatures.size)

# 6. Inspect and Slice the 2D Array:
print(temperatures[0,0:])
print(temperatures[1,0:])
print(temperatures[0,-2:])
print(temperatures[1,-2:])


# Pandas Series:
# 1. Creating Pandas Series:
import pandas as pd
marks=[95, 92, 89, 85, 80]
Custom_Indices = ['Rank1', 'Rank2', 'Rank3', 'Rank4', 'Rank5']
marks = pd.Series(marks, index=Custom_Indices)

# 2. Indexing and Slicing:
print(marks[0])
print(marks.loc[["Rank1","Rank2","Rank3"]])
print(marks.iloc[2])
print(marks[marks>90])

# 3. Manipulating Series:
marks.values[0] = 100
print(marks)
marks.loc["Rank1"] = 100
print(marks)

marks.drop("Rank5", inplace=True)
print(marks)

for i in marks:
    print(i / 10)

